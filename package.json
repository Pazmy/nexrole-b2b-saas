{
  "name": "nexrole-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w packages/database && npm run build -w apps/web",
    "lint": "npm run lint --workspaces --if-present",
    "db:generate": "npm run generate -w packages/database",
    "db:push": "npm run push -w packages/database",
    "test:e2e": "npm run test:e2e -w apps/web",
    "test:access": "node --test tests/access-control.test.cjs"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
