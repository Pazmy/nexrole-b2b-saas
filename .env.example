# Local database (non-Docker)
DATABASE_URL="postgresql://postgres:admin@localhost:5432/nexrole_db?schema=public"
AUTH_SECRET="f6c8d20387b3a4f6be4e3f898e0e84b8d789060ab725c4ef6a72b89d5a71df5c"

# Node environment
NODE_ENV=development

# URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
EXPRESS_API_URL=http://localhost:5000

# Stripe keys (example/placeholder keys)
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret
STRIPE_PRO_PRICE_ID=price_placeholder_price_id

# Docker Compose configuration
DOCKER_DB_USER=postgres
DOCKER_DB_PASSWORD=enterprise_secure_password
DOCKER_DB_NAME=nexrole_production
DOCKER_AUTH_SECRET=super_secure_nextauth_secret_token_string_32
SEED_DEMO_DATA=true #set false for deployment

# Account email: local previews need no Resend account or domain
EMAIL_MODE=preview
# Required only for EMAIL_MODE=resend
RESEND_API_KEY=
EMAIL_FROM="NexRole <onboarding@resend.dev>"
# Optional: only set to a single-IP header overwritten by your trusted reverse proxy
RATE_LIMIT_IP_HEADER=
